{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/levin-audit/claims.schema.json",
  "title": "Dietz-Sweet audit material-claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created",
    "scope",
    "not_a_truth_oracle",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "created": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "not_a_truth_oracle": {
      "const": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "attributed_to",
          "claim_type",
          "status",
          "boundary",
          "target_locations",
          "evidence",
          "check",
          "limitations",
          "revision_condition",
          "strongest_alternative"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "attributed_to": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "revision_condition": {
            "type": "string",
            "minLength": 1
          },
          "strongest_alternative": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "reproduced",
              "contradicted",
              "overstated",
              "unreproduced",
              "unverified",
              "verified_source",
              "partially_supported",
              "unsupported"
            ]
          },
          "target_locations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "line",
                "search_text"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "search_text": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "role"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}